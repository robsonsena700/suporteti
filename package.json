{
  "name": "workspace",
  "version": "V1.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node ./scripts/enforce-pnpm.cjs",
    "install:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/install-windows.ps1",
    "install:linux": "bash ./scripts/install-linux.sh",
    "dev": "node ./scripts/dev.cjs",
    "dev:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-windows.ps1",
    "test:coordinator-access": "node ./scripts/test-coordinator-access.cjs",
    "test:chat:unit": "pnpm --filter @workspace/scripts exec tsx ./src/test-chat-permissions-unit.ts && pnpm --filter @workspace/scripts exec tsx ./src/test-chat-message-rules-unit.ts",
    "test:chat:load": "pnpm --filter @workspace/scripts exec tsx ./src/loadtest-chat-endpoints.ts",
    "test:chat:integration": "node ./scripts/test-chat-permissions-integration.cjs",
    "test:tickets:unit": "pnpm --filter @workspace/scripts exec tsx ./src/test-tickets-unit.ts",
    "test:tickets:resolved:unit": "pnpm --filter @workspace/scripts exec tsx ./src/test-tickets-resolved-unit.ts",
    "test:tickets:rating-visibility:unit": "pnpm --filter @workspace/scripts exec tsx ./src/test-ticket-rating-visibility-unit.ts",
    "test:a11y:contrast": "pnpm --filter @workspace/scripts exec tsx ./src/test-priority-contrast-unit.ts",
    "test:a11y:lighthouse": "powershell -ExecutionPolicy Bypass -File ./scripts/test-a11y-lighthouse.ps1",
    "test:municipalities:seed": "pnpm --filter @workspace/scripts exec tsx ./src/test-municipalities-seed-unit.ts",
    "test:tickets:auto-assign:unit": "pnpm --filter @workspace/scripts exec tsx ./src/test-ticket-auto-assign-unit.ts",
    "test:tickets:reopen-policy:unit": "pnpm --filter @workspace/scripts exec tsx ./src/test-ticket-reopen-policy-unit.ts",
    "test:tickets:reassign-policy:unit": "pnpm --filter @workspace/scripts exec tsx ./src/test-ticket-reassign-policy-unit.ts",
    "test:tickets:receipt:unit": "pnpm --filter @workspace/scripts exec tsx ./src/test-ticket-receipt-unit.ts",
    "test:tickets:receipt:integration": "node ./scripts/test-ticket-receipt-integration.cjs",
    "test:tickets:reassign:integration": "node ./scripts/test-ticket-reassign-integration.cjs",
    "test:tickets:access-policy:unit": "pnpm --filter @workspace/scripts exec tsx ./src/test-ticket-access-policy-unit.ts",
    "test:tickets:messages:unit": "pnpm --filter @workspace/scripts exec tsx ./src/test-ticket-message-content-unit.ts",
    "test:tickets:access-control:integration": "node ./scripts/test-ticket-access-control-integration.cjs",
    "test:gestor:access-control:integration": "node ./scripts/test-gestor-access-control-integration.cjs",
    "test:tickets:visibility:all-roles:integration": "node ./scripts/test-ticket-visibility-all-roles-integration.cjs",
    "test:tickets:messages:attachments:integration": "node ./scripts/test-ticket-message-attachments-integration.cjs",
    "test:tickets:no-coordinator:integration": "node ./scripts/test-no-coordinator-access.cjs",
    "test:tickets:resolved:integration": "node ./scripts/test-tickets-resolved-integration.cjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
